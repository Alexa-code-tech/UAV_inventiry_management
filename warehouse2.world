    <!-- CEILING - prevents drone from flying out of warehouse -->
    <model name='ceiling'>
      <static>true</static>
      <pose>-1.5 1.0 5.5 0 0 0</pose>
      <link name='ceiling_link'>
        <collision name='ceiling_col'>
          <geometry><box><size>20 20 0.1</size></box></geometry>
        </collision>
        <visual name='ceiling_vis'>
          <geometry><box><size>20 20 0.1</size></box></geometry>
          <material><ambient>0.75 0.75 0.75 1</ambient><diffuse>0.75 0.75 0.75 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- WALLS - close the warehouse -->
    <model name='wall_north'>
      <static>true</static>
      <pose>-1.5 9.5 2.5 0 0 0</pose>
      <link name='link'>
        <collision name='col'><geometry><box><size>20 0.2 5.0</size></box></geometry></collision>
        <visual name='vis'><geometry><box><size>20 0.2 5.0</size></box></geometry></visual>
      </link>
    </model>
    <model name='wall_south'>
      <static>true</static>
      <pose>-1.5 -7.5 2.5 0 0 0</pose>
      <link name='link'>
