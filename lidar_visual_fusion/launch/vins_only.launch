<launch>
  <arg name="config_file"
       default="$(find VINS-Fusion)/config/euroc/euroc_mono_imu_config.yaml"/>
  <node name="vins_estimator"
        pkg="vins" type="vins_node"
        args="$(arg config_file)" output="screen"/>
  <node name="pose_graph"
        pkg="pose_graph" type="pose_graph_node"
        args="$(arg config_file)" output="screen"/>
</launch>
